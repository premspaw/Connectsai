# ─── DermaSculpt Clinic Subaccount Configuration ──────────────────────────────
# Independent deployment for client: DermaSculpt Clinic

# ─── Secrets ────────────────────────────────────────────────────────────────
FORGECRM_JWT_SECRET=f9a8c1e34b7d2f601a5e98234c718b9d0e23456789abcdef0123456789abcdef
FORGECRM_ENCRYPTION_KEY=e4b7c891a23f45d67890123456789abcdef0123456789abcdef0123456789abcd
META_WEBHOOK_VERIFY_TOKEN=dermasculpt_webhook_verify_2026
BOOTSTRAP_ADMIN_EMAIL=admin@dermasculpt.com
BOOTSTRAP_ADMIN_PASSWORD=DermaSculptAdmin2026!

# ─── Database ────────────────────────────────────────────────────────────────
# Use a separate database instance or Supabase project for 100% data isolation
# In Railway: Use the auto-provided DATABASE_URL from DermaSculpt's Postgres service
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dermasculpt_crm
POSTGRES_USER=dermasculpt
POSTGRES_PASSWORD=
POSTGRES_SSL=true

# ─── Redis (BullMQ queues) ───────────────────────────────────────────────────
# If sharing Redis, use database index /1 or a separate Redis instance:
REDIS_URL=

# ─── Object Storage (Cloudflare R2 or MinIO) ─────────────────────────────────
# Can share R2 bucket under /dermasculpt folder or use a separate bucket
CLOUDFLARE_R2_BUCKET=connects-ai-media
CLOUDFLARE_R2_PREFIX=dermasculpt/

# ─── App & Domains ───────────────────────────────────────────────────────────
PORT=3014
WEB_PORT=8081
NODE_ENV=production
# Set this to your Hostinger subdomain in production:
# e.g., https://dermasculpt.yourhostingerdomain.com
CORS_ORIGIN=https://dermasculpt.yourhostingerdomain.com
FORGECRM_DOMAIN=dermasculpt.yourhostingerdomain.com
